# Development environment example. Never commit real tokens.
VIHANGA_EDGE_VEHICLE_ID=AIR-001
VIHANGA_EDGE_SYSID=1
VIHANGA_EDGE_SERIAL_PORT=/dev/ttyAMA0
VIHANGA_EDGE_BAUD=57600
VIHANGA_EDGE_WSS=wss://YOUR-PRIVATE-RELAY/ws/v1/device/AIR-001
VIHANGA_EDGE_DEVICE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
VIHANGA_EDGE_LOCKFILE=/run/vihanga/serial.lock

# Optional direct TLS LAN viewer for Internet-independent telemetry.
# Disabled unless token, certificate and key are all configured.
# Never reuse VIHANGA_EDGE_DEVICE_TOKEN. Never commit credentials.
# VIHANGA_EDGE_LAN_BIND=192.168.1.50
# VIHANGA_EDGE_LAN_PORT=8765
# VIHANGA_EDGE_LAN_VIEW_TOKEN=GENERATE_A_SEPARATE_RANDOM_32_PLUS_CHARACTER_TOKEN
# VIHANGA_EDGE_LAN_CERT=/etc/vihanga/tls/lan.crt
# VIHANGA_EDGE_LAN_KEY=/etc/vihanga/tls/lan.key
